VITE_API_BASE_URL=http://localhost:8000/api/v1

# MercadoPago public key.
# Con prefijo TEST- (sandbox): activa los paneles de datos de prueba en el checkout.
#   - Opcion Tarjetas: muestra numero de tarjeta, vencimiento, CVV, nombre y DNI de prueba.
#   - Opcion MercadoPago: muestra credenciales de la cuenta comprador test.
# Sin prefijo TEST- (produccion): los paneles no se renderizan.
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-xxx

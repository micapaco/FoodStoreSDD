# ── Aplicacion ──────────────────────────────────────────────────────────────
APP_NAME="Food Store API"
APP_VERSION="0.1.0"
ENV=dev
DEBUG=true

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://foodstore_user:foodstore_pass@localhost:5432/foodstore_db

# ── PostgreSQL (Docker) ──────────────────────────────────────────────────────
POSTGRES_USER=foodstore_user
POSTGRES_PASSWORD=foodstore_pass
POSTGRES_DB=foodstore_db
POSTGRES_PORT=5432

# ── Seguridad ────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-min-32-chars-please-rotate-this-value

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── MercadoPago ──────────────────────────────────────────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
# MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxx

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute

# ── Payload ──────────────────────────────────────────────────────────────────
MAX_BODY_SIZE_BYTES=1048576
